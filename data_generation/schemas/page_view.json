{
  "event_type": "page_view",
  "required_fields": ["user_id", "session_id", "page_url", "page_type", "timestamp", "time_on_page_seconds", "device_type", "country"],
  "optional_fields": ["referrer"],
  "field_types": {
    "user_id": "string",
    "session_id": "string",
    "page_url": "string",
    "page_type": "string",
    "timestamp": "iso8601",
    "time_on_page_seconds": "integer",
    "referrer": "string",
    "device_type": "string",
    "country": "string"
  },
  "field_ranges": {
    "time_on_page_seconds": {"min": 1, "max": 3600},
    "page_type": {"enum": ["home", "category", "product", "cart", "checkout", "search", "other"]},
    "device_type": {"enum": ["mobile", "desktop", "tablet"]}
  }
}
